# --- WattElse RAGOrchestrator API connection ---
# Base URL of the running WattElse RAGOrchestrator API (see wattelse/api/rag_orchestrator).
WATTELSE_BASE_URL=https://localhost:1978

# Client credentials registered in WattElse's client_registry.json.
WATTELSE_CLIENT_ID=wattelse_mcp
WATTELSE_CLIENT_SECRET=abcdefghijklmnopqrstuvwxyz123456789

# Set to false only for self-signed/dev certificates.
WATTELSE_VERIFY_SSL=false

# Group/session used by the `ask` convenience tool and by the agent by default.
WATTELSE_DEFAULT_GROUP_ID=default

# Name of a config registered server-side under wattelse/rag_backend/configs/*.toml,
# used the first time a session is created for a given group.
WATTELSE_DEFAULT_CONFIG=wattelse_mcp

# Port on which the MCP server runs when using SSE transport.
WATTELSE_MCP_PORT=9994

# --- OpenAI Agents SDK (only needed to run wattelse_agent) ---
OPENAI_API_KEY=sk-...
